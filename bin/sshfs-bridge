#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
INSTALL_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
CONFIG_DIR="${HOME:?}/.wsl-vpn-ssh"
CONFIG_FILE="$CONFIG_DIR/config.json"
source "$INSTALL_ROOT/libexec/vpn-relay-pool.sh"
source "$INSTALL_ROOT/libexec/ssh-control-pool.sh"
bridge_performance_now bridge_started_at

usage() {
  cat <<'EOF'
用法:
  sshfs-bridge -h | --help
  sshfs-bridge config          交互创建配置或列出已有配置
  sshfs-bridge mount           挂载配置中的第一项
  sshfs-bridge mount -all      挂载全部配置项
  sshfs-bridge mount [name]    挂载指定配置项
  sshfs-bridge unmount [name]  卸载指定项；省略 name 时卸载全部
  sshfs-bridge status [name]   查看挂载状态
  sshfs-bridge list            列出配置项

EOF
}

die() {
  printf '错误: %s\n' "$*" >&2
  exit 1
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "缺少命令 '$1'，请先安装它"
}

need_command python3

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

case "$1" in
  -h|--help|help) usage; exit ;;
esac

if [[ "${1:-}" == config ]]; then
  [[ $# -eq 1 ]] || die "config 不接受其他参数"
  if [[ -e "$CONFIG_FILE" ]]; then
    python3 "$INSTALL_ROOT/lib/config_editor.py" sshfs "$CONFIG_FILE"
    exit
  else
    python3 "$INSTALL_ROOT/lib/config_wizard.py" sshfs "$CONFIG_DIR"
    exit
  fi
fi

[[ -r "$CONFIG_FILE" ]] || die "无法读取配置文件: $CONFIG_FILE"

# 输出以 NUL 分隔，避免空格或 shell 特殊字符破坏字段边界。
read_entries() {
  local selected="${1:-}"
  local selection_mode="${2:-all}"
  local action="${3:-list}"
  python3 - "$CONFIG_FILE" "$selected" "$selection_mode" "$PWD" "$action" <<'PY'
import json, os, sys

config_path, selected, selection_mode, invocation_dir, action = sys.argv[1:]
try:
    with open(config_path, encoding="utf-8") as f:
        data = json.load(f)
except (OSError, json.JSONDecodeError) as e:
    raise SystemExit(f"配置读取失败: {e}")

if not isinstance(data, dict):
    raise SystemExit("配置顶层必须是对象")
entries = data.get("mounts", [])
hosts = data.get("hosts", [])
if not isinstance(entries, list) or not isinstance(hosts, list):
    raise SystemExit("hosts 和 mounts 必须是数组")
host_by_name = {str(host.get("name", "")): host
                for host in hosts if isinstance(host, dict)}

found = False
required = ("name", "host", "remote_path")
for index, item in enumerate(entries):
    if not isinstance(item, dict):
        raise SystemExit(f"第 {index + 1} 项不是对象")
    missing = [key for key in required if not item.get(key)]
    if missing:
        raise SystemExit(f"第 {index + 1} 项缺少字段: {', '.join(missing)}")
    name = str(item["name"])
    if selection_mode == "named" and name != selected:
        continue
    found = True
    host_name = str(item["host"])
    host = host_by_name.get(host_name)
    if host is None:
        raise SystemExit(f"配置 '{name}' 引用的 SSH 配置不存在: {host_name}")
    host_missing = [key for key in ("ip", "user") if not host.get(key)]
    if host_missing:
        raise SystemExit(f"SSH 配置 '{host_name}' 缺少字段: {', '.join(host_missing)}")
    remote_terminal = str(item.get("remote_terminal") or "open").lower()
    if remote_terminal not in ("now", "open", "never"):
        raise SystemExit(f"配置 '{name}' 的 remote_terminal 必须是 now、open 或 never")
    if remote_terminal == "now" and selection_mode == "named" and action == "mount":
        local_path = invocation_dir
    else:
        local_path = item.get("local_path") or os.path.join(invocation_dir, name)
    if not os.path.isabs(local_path):
        local_path = os.path.abspath(os.path.join(invocation_dir, local_path))
    values = (
        name, str(host["ip"]), str(host["user"]),
        str(host.get("password") or ""),
        os.path.expanduser(str(host.get("private_key_path") or "")),
        str(item["remote_path"]), local_path,
        str(host.get("port") or 22),
        "true" if host.get("vpn", False) else "false",
        remote_terminal,
        host_name,
    )
    for value in values:
        sys.stdout.buffer.write(value.encode() + b"\0")
    if selection_mode == "first":
        break

if selection_mode == "named" and not found:
    raise SystemExit(f"未找到名为 '{selected}' 的配置")
PY
}

persist_now_local_path() {
  local name="$1" local_path="$2"
  python3 - "$CONFIG_FILE" "$name" "$local_path" <<'PY'
import json, os, tempfile, sys

config_path, selected, local_path = sys.argv[1:]
with open(config_path, encoding="utf-8") as stream:
    data = json.load(stream)

if isinstance(data, dict) and "mounts" in data:
    entries = data["mounts"]
elif isinstance(data, list):
    entries = data
elif isinstance(data, dict):
    entries = [data]
else:
    raise SystemExit("配置顶层必须是对象、数组，或包含 mounts 数组的对象")

for item in entries:
    if isinstance(item, dict) and str(item.get("name", "")) == selected:
        item["local_path"] = os.path.abspath(local_path)
        break
else:
    raise SystemExit(f"未找到名为 '{selected}' 的配置")

directory = os.path.dirname(os.path.abspath(config_path))
fd, temporary = tempfile.mkstemp(prefix=".sshfs-conf-", suffix=".json", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(data, stream, ensure_ascii=False, indent=2)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(temporary, 0o600)
    os.replace(temporary, config_path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
}

is_mounted() {
  mountpoint -q -- "$1"
}

stop_relay() {
  local name="$1" target_host="$2" target_port="$3"
  vpn_relay_release "$target_host" "$target_port" "sshfs-$name"
}

start_relay() {
  local name="$1" target_host="$2" target_port="$3"
  local relay_pid local_port relay_status
  for command in powershell.exe wslpath python3 flock; do
    need_command "$command"
  done
  read -r relay_pid local_port relay_status < <(
    vpn_relay_acquire "$target_host" "$target_port" "sshfs-$name"
  ) || die "[$name] Windows TCP 中继启动失败"
  printf '[%s] VPN 中继%s (Windows PID %s)\n' \
    "$name" "$([[ "$relay_status" == reused ]] && printf '复用' || printf '新建')" "$relay_pid" >&2
  printf '%s\n' "$local_port"
}

mount_one() {
  local name="$1" ip="$2" user="$3" password="$4" key="$5"
  local remote_path="$6" local_path="$7" port="$8" vpn="$9"
  local host_name="${10}"
  local -a options=(-p "$port" -o reconnect -o ServerAliveInterval=15 -o ServerAliveCountMax=3)
  local connect_ip="$ip" connect_port="$port"
  local host_key_alias="$ip"
  local mount_status=0
  local control_status
  local -a control_check_options=(-o StrictHostKeyChecking=accept-new)
  local mount_started_at password_started_at relay_started_at
  local control_check_started_at sshfs_started_at
  bridge_performance_now mount_started_at

  if [[ "$port" != 22 ]]; then
    host_key_alias="[$ip]:$port"
  fi

  if is_mounted "$local_path"; then
    printf '[%s] 已挂载: %s\n' "$name" "$local_path"
    return
  fi

  if [[ -n "$password" ]]; then
    bridge_performance_now password_started_at
    password="$(python3 "$INSTALL_ROOT/lib/password_crypto.py" "$CONFIG_FILE" hosts "$host_name")" \
      || die "[$name] 配置密码处理失败"
    bridge_performance_log "[$name] 密码解密" "$password_started_at"
  fi

  mkdir -p -- "$local_path"
  ssh_control_prepare || die "[$name] SSH 控制连接池初始化失败"
  if [[ "$vpn" == true ]]; then
    bridge_performance_now relay_started_at
    connect_port="$(start_relay "$name" "$ip" "$port")"
    bridge_performance_log "[$name] VPN 中继获取" "$relay_started_at"
    connect_ip="127.0.0.1"
    options=(-p "$connect_port" -o reconnect -o ServerAliveInterval=15 -o ServerAliveCountMax=3)
    options+=(-o "HostKeyAlias=$host_key_alias" -o CheckHostIP=no -o StrictHostKeyChecking=accept-new)
    control_check_options+=(
      -o "HostKeyAlias=$host_key_alias" -o CheckHostIP=no
    )
    printf '[%s] VPN 中继 127.0.0.1:%s -> %s:%s\n' \
      "$name" "$connect_port" "$ip" "$port"
    trap "stop_relay '$name' '$ip' '$port'; exit 130" INT TERM
  fi
  if [[ -n "$key" ]]; then
    [[ -r "$key" ]] || die "[$name] 私钥不可读: $key"
    options+=(-o "IdentityFile=$key")
    control_check_options+=(-i "$key")
  fi
  options+=("${SSH_CONTROL_OPTIONS[@]}")
  if [[ "${SSHFS_BRIDGE_DEBUG:-0}" == 1 ]]; then
    options+=(-f -d -o sshfs_debug -o LogLevel=DEBUG3)
    printf '[%s] 已启用 SSHFS 调试日志（不会输出密码）\n' "$name" >&2
  fi

  printf '[%s] 挂载 %s@%s:%s -> %s\n' "$name" "$user" "$ip" "$remote_path" "$local_path"
  bridge_performance_now control_check_started_at
  control_status="$(ssh_control_status \
    "$user@$connect_ip" "$connect_port" "${control_check_options[@]}")"
  bridge_performance_log "[$name] SSH 控制连接检查" "$control_check_started_at"
  printf '[%s] SSH 连接池: %s\n' "$name" \
    "$([[ "$control_status" == reused ]] && printf '复用已有连接' \
      || [[ "$control_status" == disabled ]] && printf '已禁用' \
      || printf '新建主连接')" >&2
  bridge_performance_now sshfs_started_at
  if [[ -n "$password" ]]; then
    printf '%s\n' "$password" | sshfs "${options[@]}" -o password_stdin -- \
      "$user@$connect_ip:$remote_path" "$local_path" || mount_status=$?
  else
    sshfs "${options[@]}" -- "$user@$connect_ip:$remote_path" "$local_path" </dev/null \
      || mount_status=$?
  fi
  bridge_performance_log "[$name] SSHFS 挂载命令" "$sshfs_started_at"
  trap - INT TERM
  if ((mount_status != 0)); then
    [[ "$vpn" == true ]] && stop_relay "$name" "$ip" "$port"
    return "$mount_status"
  fi
  bridge_performance_log "[$name] 挂载总计" "$mount_started_at"
}

unmount_one() {
  local name="$1" ip="$2" local_path="$7" port="$8" vpn="$9"
  local unmount_output unmount_status
  if ! is_mounted "$local_path"; then
    if findmnt -rn -M "$local_path" >/dev/null 2>&1; then
      printf '[%s] 检测到失联挂载，执行懒卸载: %s\n' "$name" "$local_path"
      if command -v fusermount3 >/dev/null 2>&1; then
        fusermount3 -uz -- "$local_path"
      elif command -v fusermount >/dev/null 2>&1; then
        fusermount -uz -- "$local_path"
      else
        umount -l -- "$local_path"
      fi
      findmnt -rn -M "$local_path" >/dev/null 2>&1 \
        && die "[$name] 失联挂载仍未解除: $local_path"
      if [[ "$vpn" == true ]]; then
        stop_relay "$name" "$ip" "$port"
      fi
      return 0
    fi
    printf '[%s] 未挂载: %s\n' "$name" "$local_path"
    if [[ "$vpn" == true ]]; then
      stop_relay "$name" "$ip" "$port"
    fi
    return 0
  fi
  printf '[%s] 卸载 %s\n' "$name" "$local_path"
  if command -v fusermount3 >/dev/null 2>&1; then
    if unmount_output="$(fusermount3 -u -- "$local_path" 2>&1)"; then
      :
    else
      unmount_status=$?
      printf '%s\n' "$unmount_output" >&2
      if [[ "$unmount_output" != *"Device or resource busy"* ]]; then
        return "$unmount_status"
      fi
      printf '[%s] 挂载点繁忙，改用懒卸载: %s\n' "$name" "$local_path"
      fusermount3 -uz -- "$local_path"
    fi
  elif command -v fusermount >/dev/null 2>&1; then
    if unmount_output="$(fusermount -u -- "$local_path" 2>&1)"; then
      :
    else
      unmount_status=$?
      printf '%s\n' "$unmount_output" >&2
      if [[ "$unmount_output" != *"Device or resource busy"* ]]; then
        return "$unmount_status"
      fi
      printf '[%s] 挂载点繁忙，改用懒卸载: %s\n' "$name" "$local_path"
      fusermount -uz -- "$local_path"
    fi
  else
    if unmount_output="$(umount -- "$local_path" 2>&1)"; then
      :
    else
      unmount_status=$?
      printf '%s\n' "$unmount_output" >&2
      if [[ "$unmount_output" != *"Device or resource busy"* ]]; then
        return "$unmount_status"
      fi
      printf '[%s] 挂载点繁忙，改用懒卸载: %s\n' "$name" "$local_path"
      umount -l -- "$local_path"
    fi
  fi
  if [[ "$vpn" == true ]]; then
    stop_relay "$name" "$ip" "$port"
  fi
  return 0
}

status_one() {
  local name="$1" local_path="$7"
  if is_mounted "$local_path"; then
    printf '%-20s mounted    %s\n' "$name" "$local_path"
  else
    printf '%-20s unmounted  %s\n' "$name" "$local_path"
  fi
}

list_one() {
  local name="$1" ip="$2" user="$3" remote_path="$6" local_path="$7" port="$8"
  printf '%-20s %s@%s:%s:%s -> %s\n' "$name" "$user" "$ip" "$port" "$remote_path" "$local_path"
}

main() {
  local action="${1:-}" selected="${2:-}"
  local entries_file selection_mode="all" enter_remote_terminal="false"
  [[ $# -le 2 ]] || { usage >&2; exit 2; }
  case "$action" in
    mount)
      need_command sshfs
      need_command mountpoint
      if [[ -z "$selected" ]]; then
        selection_mode="first"
      elif [[ "$selected" == "-all" ]]; then
        selected=""
        selection_mode="all"
      else
        selection_mode="named"
      fi
      ;;
    unmount|status)
      need_command mountpoint
      [[ "$action" == unmount ]] && need_command findmnt
      if [[ -n "$selected" ]]; then
        selection_mode="named"
      fi
      ;;
    list) [[ -z "$selected" ]] || die "list 不接受 name 参数" ;;
    -h|--help|help) usage; return ;;
    *) usage >&2; exit 2 ;;
  esac

  entries_file="$(mktemp "${TMPDIR:-/tmp}/sshfs-conf.XXXXXX")"
  trap "rm -f -- '$entries_file'" EXIT
  read_entries "$selected" "$selection_mode" "$action" >"$entries_file" || exit $?
  bridge_performance_log "SSHFS 配置读取" "$bridge_started_at"

  while IFS= read -r -d '' name \
    && IFS= read -r -d '' ip \
    && IFS= read -r -d '' user \
    && IFS= read -r -d '' password \
    && IFS= read -r -d '' key \
    && IFS= read -r -d '' remote_path \
    && IFS= read -r -d '' local_path \
    && IFS= read -r -d '' port \
    && IFS= read -r -d '' vpn \
    && IFS= read -r -d '' remote_terminal \
    && IFS= read -r -d '' host_name; do
    if [[ "$remote_terminal" == now && "$local_path" == "$PWD" ]]; then
      printf '[%s] 提示：now 模式将远程目录直接挂载到当前目录: %s\n' "$name" "$PWD"
    fi
    case "$action" in
      mount)
        mount_one "$name" "$ip" "$user" "$password" "$key" "$remote_path" "$local_path" "$port" "$vpn" "$host_name"
        if [[ "$remote_terminal" == now ]]; then
          persist_now_local_path "$name" "$local_path" \
            || die "[$name] 无法记录 now 模式的挂载目录"
          printf '[%s] 已记录挂载目录: %s\n' "$name" "$local_path"
          if [[ "$selection_mode" == named && "${SSHFS_BRIDGE_NO_TERMINAL:-0}" != 1 ]]; then
            enter_remote_terminal="true"
          fi
        fi
        ;;
      unmount) unmount_one "$name" "$ip" "$user" "$password" "$key" "$remote_path" "$local_path" "$port" "$vpn" ;;
      status) status_one "$name" "$ip" "$user" "$password" "$key" "$remote_path" "$local_path" "$port" "$vpn" ;;
      list) list_one "$name" "$ip" "$user" "$password" "$key" "$remote_path" "$local_path" "$port" "$vpn" ;;
    esac
  done <"$entries_file"

  # A named now mount is a complete workflow: mount into the invocation
  # directory, then replace this process with the matching interactive SSH
  # session. ssh-bridge uses remote_terminal=now to cd to remote_path.
  if [[ "$enter_remote_terminal" == true ]]; then
    rm -f -- "$entries_file"
    trap - EXIT
    export SSH_BRIDGE_MOUNT_NAME="$selected"
    exec "$SCRIPT_DIR/ssh-bridge" "$host_name"
  fi
}

main "$@"
